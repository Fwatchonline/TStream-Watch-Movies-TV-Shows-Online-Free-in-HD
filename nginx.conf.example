# Nginx Production Configuration Template for TStream.online
# Architecture: Atomic release symlink (<APP_DIR>/current/dist) + Node.js Runtime SEO & Streaming Server
#
# IMPORTANT: Replace /var/www/tstream below with your verified production APP_DIR
# before installing into /etc/nginx/sites-available/tstream.online.
# Test syntax before reload: sudo nginx -t && sudo systemctl reload nginx

# 1. HTTP (port 80) -> Canonical HTTPS non-www 301 Permanent Redirect
server {
    listen 80;
    listen [::]:80;
    server_name tstream.online www.tstream.online;
    return 301 https://tstream.online$request_uri;
}

# 2. WWW (HTTPS) -> Canonical non-www HTTPS 301 Permanent Redirect
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.tstream.online;

    ssl_certificate /etc/letsencrypt/live/tstream.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tstream.online/privkey.pem;

    return 301 https://tstream.online$request_uri;
}

# 3. Main Canonical HTTPS Production Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tstream.online;

    # Point to atomic current/ release dist/ (update path to match verified APP_DIR)
    root /var/www/tstream/current/dist;
    index index.html;

    # Preserve genuine upstream 404/503 status codes from Node.js SEO/API server (never mask errors as 200!)
    proxy_intercept_errors off;

    # Buffer & Timeout settings for SSR stability
    client_max_body_size 50M;
    proxy_connect_timeout 30s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Hashed Vite Static Assets under /assets/ — long immutable cache, genuine 404 if missing
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Unhashed Static Assets & Media — short cache / revalidated, genuine 404 if missing
    location ~* \.(?:ico|css|js|mjs|map|gif|jpe?g|png|svg|woff2?|webp|mp4|webm|m3u8|ts|webmanifest)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400, no-transform" always;
        try_files $uri =404;
    }

    # XML Sitemaps & robots.txt — short cache so updates propagate cleanly, genuine 404 if missing
    location ~* \.xml$ {
        default_type application/xml;
        expires 5m;
        add_header Cache-Control "public, max-age=300, must-revalidate, no-transform" always;
        try_files $uri =404;
    }

    location = /robots.txt {
        default_type text/plain;
        expires 5m;
        add_header Cache-Control "public, max-age=300, must-revalidate, no-transform" always;
        try_files $uri =404;
    }

    # Stream & Media Proxy Endpoints: disable proxy buffering & preserve Range / HLS streaming behavior
    location ~ ^/api/(?:stream-proxy|stream-resolve|proxy|stream/|subtitle-proxy) {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # General API routes (/api/health, /api/tmdb/*)
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hybrid SSG + Runtime SEO Routing:
    # - Requests with query strings (?page=2, ?genreId=28, /search?q=...) bypass static files
    #   and route directly to Node runtime (@seo_runtime) for dynamic pagination, canonical & noindex.
    # - Query-less routes serve existing pre-rendered static HTML ($uri/index.html) directly,
    #   and fall back to @seo_runtime so live TMDB routes return 200 and nonexistent routes return 404/503.
    # - NEVER use `error_page 404 /index.html;`
    location / {
        if ($is_args = "?") {
            return 418;
        }
        error_page 418 = @seo_runtime;
        try_files $uri $uri/index.html @seo_runtime;
    }

    location @seo_runtime {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
