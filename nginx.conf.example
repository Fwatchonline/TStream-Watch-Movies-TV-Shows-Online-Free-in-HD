# Nginx Production Configuration for TStream.online (Hybrid SSG + Node.js Runtime SEO)
# File location on VPS: /etc/nginx/sites-available/tstream.online
# Enable with: sudo ln -sf /etc/nginx/sites-available/tstream.online /etc/nginx/sites-enabled/
# Test with: sudo nginx -t && sudo systemctl reload nginx

# 1. HTTP (port 80) -> Canonical HTTPS non-www 301 Permanent Redirect
server {
    listen 80;
    listen [::]:80;
    server_name tstream.online www.tstream.online;
    return 301 https://tstream.online$request_uri;
}

# 2. WWW (HTTPS) -> Canonical non-www HTTPS 301 Permanent Redirect
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.tstream.online;

    ssl_certificate /etc/letsencrypt/live/tstream.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tstream.online/privkey.pem;

    return 301 https://tstream.online$request_uri;
}

# 3. Main Canonical HTTPS Production Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tstream.online;

    root /var/www/tstream/dist;
    index index.html;

    # Preserve genuine upstream 404/503 status codes from Node.js SEO/API server
    proxy_intercept_errors off;

    # Buffer & Timeout settings for streaming & SSR stability
    client_max_body_size 50M;
    proxy_connect_timeout 30s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static Assets (JS, CSS, Images, Fonts, Video Chunks) — missing assets return genuine 404
    location ~* \.(?:ico|css|js|mjs|map|gif|jpe?g|png|svg|woff2?|webp|mp4|webm|m3u8|ts|webmanifest)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # XML Sitemaps & robots.txt — direct static delivery with genuine 404 if missing
    location ~* \.xml$ {
        default_type application/xml;
        expires 1d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    location = /robots.txt {
        default_type text/plain;
        expires 1d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Proxy API & Stream routes to Node.js / PM2 production server (dist/server.mjs) on port 3000
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Hybrid SSG + Runtime SEO Routing:
    # - Requests with query strings (?page=2, ?genre=28, /search?q=...) bypass static files
    #   and route directly to Node runtime (@seo_runtime) for dynamic canonical & noindex headers.
    # - Query-less routes check pre-rendered static HTML first ($uri/index.html), then
    #   fall back to @seo_runtime so live TMDB routes return 200 and nonexistent routes return 404.
    location / {
        if ($is_args = "?") {
            return 418;
        }
        error_page 418 = @seo_runtime;
        try_files $uri $uri/index.html @seo_runtime;
    }

    location @seo_runtime {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
