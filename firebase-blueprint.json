{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document with identification and account timestamps",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "playerSettings": {
          "type": "object",
          "description": "User custom streaming server, subtitle preferences, and player settings"
        }
      },
      "required": ["userId", "email"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "Individual movie or TV series saved in the user's watchlist",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tmdbId": { "type": "string" },
        "mediaType": { "type": "string" },
        "title": { "type": "string" },
        "posterPath": { "type": "string" },
        "voteAverage": { "type": "number" },
        "releaseDate": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["userId", "tmdbId", "mediaType", "title"]
    },
    "ContinueWatchingItem": {
      "title": "ContinueWatchingItem",
      "description": "Playback progress item saved in Firestore exclusively for registered users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tmdbId": { "type": "string" },
        "mediaType": { "type": "string" },
        "title": { "type": "string" },
        "posterPath": { "type": "string" },
        "backdropPath": { "type": "string" },
        "progressSeconds": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "percentage": { "type": "number" },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "episodeName": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "tmdbId", "mediaType", "title", "progressSeconds", "durationSeconds", "percentage", "updatedAt"]
    },
    "ReportItem": {
      "title": "ReportItem",
      "description": "User reported video or stream problem displayed in the admin panel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mediaId": { "type": "string" },
        "mediaType": { "type": "string" },
        "mediaTitle": { "type": "string" },
        "posterPath": { "type": "string" },
        "season": { "type": "number" },
        "episode": { "type": "number" },
        "server": { "type": "string" },
        "reason": { "type": "string" },
        "reportedAt": { "type": "string" },
        "status": { "type": "string" },
        "userEmail": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "mediaId", "mediaTitle", "server", "reason", "reportedAt", "status"]
    },
    "MovieStats": {
      "title": "MovieStats",
      "description": "Real view count and user rating stats for movies and shows",
      "type": "object",
      "properties": {
        "mediaId": { "type": "string" },
        "mediaType": { "type": "string" },
        "title": { "type": "string" },
        "views": { "type": "number" },
        "ratingSum": { "type": "number" },
        "ratingCount": { "type": "number" },
        "lastViewedAt": { "type": "string" }
      },
      "required": ["mediaId", "views"]
    },
    "EmbedServerConfig": {
      "title": "EmbedServerConfig",
      "description": "Customizable streaming embed player and server configurations managed by administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "badge": { "type": "string" },
        "dotColor": { "type": "string" },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" },
        "movieUrlTemplate": { "type": "string" },
        "tvUrlTemplate": { "type": "string" }
      },
      "required": ["id", "name", "type", "enabled"]
    },
    "FollowedShow": {
      "title": "FollowedShow",
      "description": "TV series followed by a registered user to receive new episode notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "showId": { "type": "string" },
        "title": { "type": "string" },
        "posterPath": { "type": "string" },
        "backdropPath": { "type": "string" },
        "voteAverage": { "type": "number" },
        "lastAiredSeason": { "type": "number" },
        "lastAiredEpisode": { "type": "number" },
        "followedAt": { "type": "string" }
      },
      "required": ["userId", "showId", "title", "followedAt"]
    },
    "EpisodeNotification": {
      "title": "EpisodeNotification",
      "description": "Notification alert sent to a user when a followed TV series releases a new episode",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "showId": { "type": "string" },
        "showTitle": { "type": "string" },
        "posterPath": { "type": "string" },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "episodeName": { "type": "string" },
        "airDate": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "showId", "showTitle", "seasonNumber", "episodeNumber", "read", "createdAt"]
    },
    "SiteVisit": {
      "title": "SiteVisit",
      "description": "Individual visitor page view log for real-time site analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "referrer": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "isRegistered": { "type": "boolean" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "path", "timestamp", "device", "browser"]
    },
    "DailyAnalytics": {
      "title": "DailyAnalytics",
      "description": "Daily aggregated website traffic statistics",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "pageViews": { "type": "number" },
        "uniqueVisits": { "type": "number" },
        "registeredVisits": { "type": "number" },
        "guestVisits": { "type": "number" }
      },
      "required": ["date", "pageViews"]
    },
    "AnalyticsSummary": {
      "title": "AnalyticsSummary",
      "description": "Overall lifetime website metrics and registered users counter",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "totalPageViews": { "type": "number" },
        "registeredUsersCount": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["totalVisits"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document storing basic user details"
    },
    "/users/{userId}/watchlist/{itemId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "User private watchlist items"
    },
    "/users/{userId}/continueWatching/{itemId}": {
      "schema": { "$ref": "#/entities/ContinueWatchingItem" },
      "description": "User private continue watching progress records"
    },
    "/users/{userId}/followedShows/{showId}": {
      "schema": { "$ref": "#/entities/FollowedShow" },
      "description": "TV series followed by the registered user for episode tracking"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/EpisodeNotification" },
      "description": "New episode notification records delivered to the user"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReportItem" },
      "description": "Playback reports and problem tickets visible in the admin panel"
    },
    "/movieStats/{mediaKey}": {
      "schema": { "$ref": "#/entities/MovieStats" },
      "description": "Global movie and TV show view counts and interactive user ratings"
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/EmbedServerConfig" },
      "description": "Global application and embed player configurations managed by administrator"
    },
    "/analytics_visits/{visitId}": {
      "schema": { "$ref": "#/entities/SiteVisit" },
      "description": "Real-time individual site visit logs for administrator analytics"
    },
    "/analytics_daily/{dateId}": {
      "schema": { "$ref": "#/entities/DailyAnalytics" },
      "description": "Daily aggregated site visit statistics"
    },
    "/analytics_summary/{summaryId}": {
      "schema": { "$ref": "#/entities/AnalyticsSummary" },
      "description": "High-level analytics overview and aggregate counters"
    }
  }
}
