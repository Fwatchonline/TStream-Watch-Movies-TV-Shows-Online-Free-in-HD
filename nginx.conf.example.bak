# Nginx Production Configuration for TStream.online
# File location on VPS: /etc/nginx/sites-available/tstream.online
# Enable with: sudo ln -s /etc/nginx/sites-available/tstream.online /etc/nginx/sites-enabled/
# Test with: sudo nginx -t && sudo systemctl reload nginx

# 1. HTTP to HTTPS automatic redirection
server {
    listen 80;
    listen [::]:80;
    server_name tstream.online www.tstream.online;
    return 301 https://tstream.online$request_uri;
}

# 2. Redirect www to non-www (canonical domain)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.tstream.online;

    ssl_certificate /etc/letsencrypt/live/tstream.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tstream.online/privkey.pem;

    return 301 https://tstream.online$request_uri;
}

# 3. Main HTTPS Production Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tstream.online;

    root /var/www/tstream/dist;
    index index.html;

    # SSL Certificates (Let's Encrypt Certbot)
    ssl_certificate /etc/letsencrypt/live/tstream.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tstream.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Buffer & Timeout settings to prevent 502/504 Bad Gateway
    client_max_body_size 50M;
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static Assets Caching (JS, CSS, Images, Icons)
    location ~* \.(?:ico|css|js|gif|jpe?g|png|svg|woff2?|webp|mp4|webm|m3u8|ts)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # XML Sitemaps & robots.txt (Direct static delivery with proper mime types)
    location ~* \.(?:xml|txt)$ {
        expires 1d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Proxy API & Stream routes to Node.js backend if running PM2 (e.g. port 3000 / 3010)
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # SPA History Fallback (Crucial: routes like /watch/movie/..., /movies, /tv-shows load index.html)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Custom Error Pages
    error_page 404 /index.html;
    error_page 500 502 503 504 /index.html;
}
