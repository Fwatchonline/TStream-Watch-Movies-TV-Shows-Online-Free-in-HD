# TStream.online Environment Configuration Template
# Copy to .env on production VPS or local environment (never commit real secrets).

# Required for live TMDB metadata fetching in SSR/SEO engine & client catalog
TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Production server binding
PORT=3000
HOST=0.0.0.0

# Canonical public origin
APP_URL=https://tstream.online
