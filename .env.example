# TStream.online Environment Configuration Template
# Copy to <APP_DIR>/shared/.env on production VPS or .env locally (never commit real secrets).

# Required for live TMDB metadata fetching in SSR/SEO engine & server-side /api/tmdb proxy
# Never expose TMDB_API_KEY as a VITE_* client variable.
TMDB_API_KEY=your_tmdb_api_key_here

# Production server binding
PORT=3000
HOST=0.0.0.0

# Canonical public origin
APP_URL=https://tstream.online

# Default ISO 3166-1 alpha-2 streaming availability region (e.g., US, GB, CA, DE, HR)
DEFAULT_WATCH_REGION=US

# TMDB Proxy security & rate limiting (process-local bounded in-memory sliding window)
TMDB_RATE_LIMIT_MAX=120
TMDB_RATE_LIMIT_WINDOW_MS=60000
# Set TRUST_PROXY=true ONLY when running behind a trusted reverse proxy (e.g., Nginx on 127.0.0.1)
TRUST_PROXY=true
# Optional comma-separated additional allowed CORS origins for /api/tmdb/*
CORS_ALLOWED_ORIGINS=https://tstream.online
