rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'snapmire@gmail.com' ||
        request.auth.token.email.lower() == 'miroslav87@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User private data (Profile, Watchlist, Continue Watching, Player Settings)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId)
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId) || isAdmin();

      match /watchlist/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /continueWatching/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /followedShows/{showId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Video & Playback Reports (Visible in Admin Panel)
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Real View Counts and User Ratings for Movies and TV Shows
    match /movieStats/{mediaKey} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Global System Settings & Custom Embed Servers
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Site Analytics, Visits & Metrics
    match /analytics_visits/{visitId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    match /analytics_daily/{dateId} {
      allow read: if true;
      allow write: if true;
    }

    match /analytics_summary/{summaryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
