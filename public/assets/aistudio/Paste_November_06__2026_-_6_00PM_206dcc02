Tsx
import React, { useEffect, useRef, useState } from 'react';
import Hls from 'hls.js';

interface StreamServer {
  key: string;
  label: string;
  url: string;
  type: 'hls' | 'mp4';
}

export const VideoPlayer: React.FC<{ type: 'movie' | 'tv'; id: string; season?: number; episode?: number }> = ({
  type,
  id,
  season,
  episode
}) => {
  const videoRef = useRef<HTMLVideoElement>(null);
  const hlsRef = useRef<Hls | null>(null);

  const [servers, setServers] = useState<StreamServer[]>([]);
  const [currentServer, setCurrentServer] = useState<StreamServer | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // 1. Dobijanje radnih servera sa backend API-ja
  useEffect(() => {
    let active = true;
    setLoading(true);
    setError(null);

    const query = season && episode ? `?season=${season}&episode=${episode}` : '';
    fetch(`/api/stream/${type}/${id}${query}`)
      .then(r => r.json())
      .then(data => {
        if (!active) return;
        if (data.success && data.servers?.length > 0) {
          setServers(data.servers);
          setCurrentServer(data.servers[0]); // Bira server najvišeg prioriteta
        } else {
          setError('Nema dostupnih servera za ovaj naslov.');
        }
      })
      .catch(e => {
        if (active) setError(e.message);
      })
      .finally(() => {
        if (active) setLoading(false);
      });

    return () => { active = false; };
  }, [type, id, season, episode]);

  // 2. Automatsko pokretanje HLS.js ili native MP4 reprodukcije
  useEffect(() => {
    if (!currentServer || !videoRef.current) return;
    const video = videoRef.current;

    if (hlsRef.current) {
      hlsRef.current.destroy();
      hlsRef.current = null;
    }

    if (currentServer.type === 'hls' && Hls.isSupported()) {
      const hls = new Hls({
        enableWorker: true,
        lowLatencyMode: false,
        backBufferLength: 90
      });
      hlsRef.current = hls;
      hls.loadSource(currentServer.url);
      hls.attachMedia(video);

      hls.on(Hls.Events.ERROR, (_, data) => {
        if (data.fatal) {
          console.warn(`Server ${currentServer.label} failed, prebacujem na sledeći...`);
          // Automatski failover na sledeći server
          setServers(prev => {
            const nextList = prev.filter(s => s.key !== currentServer.key);
            if (nextList.length > 0) setCurrentServer(nextList[0]);
            return nextList;
          });
        }
      });
    } else {
      video.src = currentServer.url;
      video.onerror = () => {
        console.warn(`Server ${currentServer.label} MP4 error, prebacujem na sledeći...`);
        setServers(prev => {
          const nextList = prev.filter(s => s.key !== currentServer.key);
          if (nextList.length > 0) setCurrentServer(nextList[0]);
          return nextList;
        });
      };
    }
  }, [currentServer]);

  if (loading) return <div className="p-10 text-center text-white">Učitavanje servera...</div>;
  if (error) return <div className="p-10 text-center text-red-400">{error}</div>;

  return (
    <div className="relative w-full aspect-video bg-black rounded-xl overflow-hidden shadow-2xl">
      <video ref={videoRef} controls autoPlay className="w-full h-full object-contain" />

      {/* Meni za brzi ručni izbor servera */}
      <div className="absolute top-3 right-3 flex items-center gap-1.5 bg-black/70 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 text-xs">
        <span className="text-zinc-400 font-medium">Server:</span>
        <select
          value={currentServer?.key || ''}
          onChange={(e) => {
            const found = servers.find(s => s.key === e.target.value);
            if (found) setCurrentServer(found);
          }}
          className="bg-transparent text-teal-300 font-semibold outline-none cursor-pointer"
        >
          {servers.map(s => (
            <option key={s.key} value={s.key} className="bg-zinc-900 text-white">
              {s.label} ({s.type.toUpperCase()})
            </option>
          ))}
        </select>
      </div>
    </div>
  );
};
🚀 KAKO SVE OVO FUNKCIONIŠE NA NOVOM SAJTU
TMDB ID unos: Kada korisnik otvori bilo koji film ili seriju (npr. The Dark Knight 155), frontend pozove /api/stream/movie/155.
Brza orkestracija: Backend paralelno proverava Vector, Valence, Eclipse, BoxMovie i Apex.
Automatski CORS i CDN bypass: Svi HLS streamovi i MP4 fajlovi se vraćaju kroz /api/proxy, koji u hodu prepisuje segmente i dodaje odgovarajuće Referer i Origin hedere.
Neprekidna reprodukcija (Zero-Interruption): Ako provajder sa prioritetom 1 ikada zakaže ili se baferuje, plejer bez prekidanja i bez greške prebacuje na sledeći aktivan server.